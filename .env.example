# GeekyAce Digital Hub environment variables
#
# Copy this file to .env.local for local development.
# NEVER commit real credentials or production secrets.

# Database
DATABASE_POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Admin authentication
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Gemini AI
GEMINI_API_KEY=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="GeekyAce Digital Hub <hello@geekyacedigitalhub.com>"

# Optional MerchantOS support recipient
MERCHANTOS_SUPPORT_EMAIL="hello@geekyacedigitalhub.com"

# Contact form target
CONTACT_TO_EMAIL="hello@geekyacedigitalhub.com"

# Public site URL (used for absolute links / OG / sitemap pings)
NEXT_PUBLIC_SITE_URL="https://geekyacedigitalhub.com"

# ---- Search Console verification tokens ----
# Add in Vercel → Settings → Environment Variables. Each one adds the
# corresponding <meta name="google-site-verification"> (or bing / yandex
# / pinterest) tag automatically. Leave blank / unset to skip.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
YANDEX_SITE_VERIFICATION=""
PINTEREST_SITE_VERIFICATION=""

# Shared secret for /api/ping-search-engines (deploy hook). Generate a
# random string, set it in Vercel, then add the deploy hook described in
# docs/SEO-SETUP.md. Leave empty to disable the ping endpoint.
PING_SECRET=""
