                      href={platform.available ? platform.href : undefined}
                      target={platform.available ? "_blank" : undefined}
                      rel={platform.available ? "noreferrer" : undefined}
                      aria-disabled={!platform.available}
                      onClick={(event) => {
                        if (!platform.available) {
                          event.preventDefault();
                        }
                      }}
                      className={`flex items-center gap-3 rounded-xl border p-3 transition ${
                        platform.available
                          ? "border-slate-200 bg-white text-slate-700 hover:border-green-300 hover:bg-green-50 hover:text-green-700"
                          : "cursor-default border-slate-100 bg-slate-50 text-slate-400"
