generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  role         String
  bio          String
  location     String?
  availability String   @default("Available")
  skills       String
  expertise    String
  platforms    String
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}