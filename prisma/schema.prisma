generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_URL")
}

model TeamMember {
  id           String   @id @default(cuid())
  slug         String?  @unique
  name         String
  role         String
  headline     String?
  studioId     String?
  bio          String
  location     String?
  availability String   @default("Available")
  yearsExperience Int?
  skills       String
  expertise    String
  platforms    String
  languages    String?
  portfolioUrl String?
  imageUrl     String?
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studioId, published])
}

model Lead {
  id                  String   @id @default(cuid())
  name                String?
  email               String?
  businessName        String?
  businessType        String?
  projectType         String?
  mainGoal            String?
  features            String?
  targetUsers         String?
  timeline            String?
  budget              String?
  recommendedService  String?
  conversationSummary String?
  source               String?
  serviceSlug          String?
  studioId             String?
  referrer             String?
  consent              Boolean  @default(false)
  attachments          String?
  status              String   @default("NEW")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  aceMatchBrief AceMatchBrief?

  @@index([status, createdAt])
  @@index([source])
}

model AceMatchBrief {
  id                    String   @id @default(cuid())
  goal                  String
  studioId              String
  serviceSlug           String?
  audience              String
  stage                 String
  timeline              String
  budget                String
  context               String
  recommendedRoles      String
  recommendedPhases     String
  recommendedDeliverables String
  source                String   @default("WEBSITE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([studioId, createdAt])
  @@index([serviceSlug])
}

model CaseStudy {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  summary              String
  challenge            String
  approach             String
  outcome              String
  studioId             String
  serviceSlugs         String
  industries           String
  heroImageUrl         String?
  mediaUrls            String?
  proofStatus          String   @default("CONCEPT")
  proofUrl              String?
  clientPermission     Boolean  @default(false)
  clientDisplayName    String?
  featured             Boolean  @default(false)
  published            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([published, featured])
  @@index([studioId, proofStatus])
}

model Client {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  company      String?
  phone        String?
  passwordHash String
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects Project[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("PLANNING")
  progress    Int      @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  budget      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  milestones ProjectMilestone[]
  updates    ProjectUpdate[]

  @@index([clientId, status])
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("PENDING")
  dueDate     DateTime?
  completedAt DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  title     String
  message   String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
